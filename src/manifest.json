{
    "manifest_version": 3,
    "name": "OrigiSave - Original Media Downloader",
    "version": "1.0.0",
    "description": "Download original media from X (Twitter) and Discord.",
    "permissions": [
        "downloads",
        "contextMenus",
        "storage"
    ],
    "host_permissions": [
        "*://twitter.com/*",
        "*://x.com/*",
        "*://discord.com/*",
        "*://*.discordapp.net/*",
        "*://*.discordapp.com/*"
    ],
    "action": {
        "default_popup": "src/popup/index.html"
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://twitter.com/*",
                "*://x.com/*"
            ],
            "js": [
                "src/content/x-main.ts"
            ],
            "world": "MAIN"
        },
        {
            "matches": [
                "*://twitter.com/*",
                "*://x.com/*",
                "*://discord.com/*"
            ],
            "js": [
                "src/content/index.ts"
            ]
        }
    ]
}